                  "amount": { "type": "number" },
                  "method": { "type": "string", "enum": ["cash", "card", "cheque", "bank_transfer", "other"] },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Payment added" } }
